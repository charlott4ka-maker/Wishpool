# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app.

# Wishpool backend (the same server the Telegram Mini App uses).
EXPO_PUBLIC_API_URL=https://your-wishpool-domain.example

# Affiliate tags (see src/services/affiliate/config.ts). Leave empty to skip a network.
EXPO_PUBLIC_AFFILIATE_TAG=wishpool
EXPO_PUBLIC_AMAZON_ASSOCIATES_TAG=
EXPO_PUBLIC_ROZETKA_AFFILIATE_ID=
# Admitad deeplinks per shop id (src/services/affiliate/shops.ts), JSON:
EXPO_PUBLIC_ADMITAD_LINKS={"makeup":"https://ad.admitad.com/g/xxxx/","rozetka":"https://ad.admitad.com/g/yyyy/"}
# Fallback Admitad deeplink for Admitad shops without their own entry, and AliExpress shortcut:
EXPO_PUBLIC_ADMITAD_BASE_URL=
EXPO_PUBLIC_ALIEXPRESS_ADMITAD_URL=

# RevenueCat public iOS SDK key (appl_...). Without it purchases run in mock mode.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_MOCK=

# Paywall legal links. Terms default to Apple's standard EULA; App Review needs a Privacy Policy URL.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
