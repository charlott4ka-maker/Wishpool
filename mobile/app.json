{
  "expo": {
    "name": "Wishpool",
    "slug": "wishpool",
    "scheme": "wishpool",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15181D",
    "primaryColor": "#0A82F9",
    "ios": {
      "bundleIdentifier": "app.wishpool.ios",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Wishpool uses your photos so you can add pictures to your wishes.",
        "NSPhotoLibraryAddUsageDescription": "Wishpool saves wish photos to your library when you ask it to.",
        "NSCameraUsageDescription": "Wishpool uses the camera so you can photograph something you wish for.",
        "LSApplicationQueriesSchemes": [
          "tg"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "uk",
          "ru",
          "en"
        ]
      },
      "associatedDomains": [
        "applinks:wishpool.clickbrickk.com"
      ],
      "appleTeamId": "5LA5WMXQUM"
    },
    "android": {
      "package": "app.wishpool.android",
      "adaptiveIcon": {
        "backgroundColor": "#1A84F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#15181D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wishpool uses your photos so you can add pictures to your wishes.",
          "cameraPermission": "Wishpool uses the camera so you can photograph something you wish for."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Glow",
            "ios": "./assets/icons/glow.png",
            "android": {
              "foregroundImage": "./assets/icons/glow-fg.png",
              "backgroundColor": "#0E163A"
            }
          }
        ]
      ],
      "@react-native-community/datetimepicker",
      [
        "./plugins/withShareExtensionDisplayName",
        {
          "target": "WishpoolShare",
          "name": "Wishpool"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "WishpoolShare",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "charlott4ka",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/309fd266-5511-4c13-8cfe-a7fcda6f1259"
    },
    "extra": {
      "eas": {
        "projectId": "309fd266-5511-4c13-8cfe-a7fcda6f1259"
      }
    }
  }
}
