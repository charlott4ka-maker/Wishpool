{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/p/:path*",
      "destination": "https://pub-f403a898e7fa471f804e291a1fdc1c66.r2.dev/:path*"
    },
    {
      "source": "/join/:id",
      "destination": "/join/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/stickers/:name",
      "destination": "https://pub-f403a898e7fa471f804e291a1fdc1c66.r2.dev/stickers/:name"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "refresh-on-classic": false,
      "glass-navigation-folders": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/remind",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/p/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=31536000"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/stickers/:name",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
